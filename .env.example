# Copy this file to .env and fill in values ONLY if you want the optional
# Supabase-backed UPC database (see README.md "UPC database" section).
#
# The engine works fully standalone without this file -- identify, convert,
# decompose, detect, and profile management have zero dependency on it.
# Only the `db-record` / `db-get` / `db-list` CLI commands (and the
# recordUpc/getUpcRecord/listUpcRecords/isDbConfigured functions in
# src/db.mjs) need these set.

# Your Supabase project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# Service-role key (Project Settings -> API -> service_role, NOT the anon
# key -- writes go through this and RLS is bypassed by the service role).
# Get this via a secure credential flow, never commit it to git.
SUPABASE_SERVICE_ROLE_KEY=
